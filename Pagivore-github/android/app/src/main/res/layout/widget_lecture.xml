<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fond"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EN LECTURE"
        android:textColor="#FF5B4F"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/titre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Aucun livre en cours"
        android:textColor="#F2EFE9"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#A29D94"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/progression"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:progressTint="#FF5B4F" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Chronometer
            android:id="@+id/chrono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F2EFE9"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/bouton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/widget_bouton"
            android:paddingHorizontal="18dp"
            android:text="Lire"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
